  <diagram id="constraints-and-enums" name="Constraints and enums">
    <mxGraphModel dx="2420" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="details-title" value="&lt;b&gt;Database constraints &amp;amp; enum storage&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=28;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="70" y="30" width="1450" height="45" as="geometry" />
        </mxCell>
        <mxCell id="details-subtitle" value="SQL Server check expressions from the EF Core migration snapshot" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=16;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="70" y="85" width="1450" height="35" as="geometry" />
        </mxCell>
        <mxCell id="checks-City" value="&lt;b&gt;Cities&lt;/b&gt;&lt;br&gt;&lt;b&gt;CK_City_NumberOfHotels_NonNegative&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[NumberOfHotels] &amp;gt;= 0&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="1450" height="87" as="geometry" />
        </mxCell>
        <mxCell id="checks-Hotel" value="&lt;b&gt;Hotels&lt;/b&gt;&lt;br&gt;&lt;b&gt;CK_Hotel_PhoneNumber_ValidFormat&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[PhoneNumber] NOT LIKE &amp;#x27;%[^0-9]%&amp;#x27; AND LEN(PhoneNumber) BETWEEN 7 AND 15&lt;/font&gt;&lt;br&gt;&lt;b&gt;CK_Hotel_PricePerNight_NonNegative&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[PricePerNight] &amp;gt;= 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;CK_Hotel_StarRating_InRange&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[StarRating] BETWEEN 1 AND 5&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="1450" height="191" as="geometry" />
        </mxCell>
        <mxCell id="checks-Reservation" value="&lt;b&gt;Reservations&lt;/b&gt;&lt;br&gt;&lt;b&gt;CK_reservation_NumberOfRooms_Positive&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[NumberOfRooms] &amp;gt; 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;CK_reservation_TotalPrice_NonNegative&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[TotalPrice] &amp;gt;= 0&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="459" width="1450" height="139" as="geometry" />
        </mxCell>
        <mxCell id="checks-Room" value="&lt;b&gt;Rooms&lt;/b&gt;&lt;br&gt;&lt;b&gt;CK_Room_AdultsCapacity_NonNegative&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[AdultsCapacity] &amp;gt;= 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;CK_Room_ChildrenCapacity_NonNegative&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[ChildrenCapacity] &amp;gt;= 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;CK_Room_RoomNumber_Positive&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[RoomNumber] &amp;gt; 0&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="616" width="1450" height="191" as="geometry" />
        </mxCell>
        <mxCell id="checks-User" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;b&gt;CK_User_Email_ValidFormat&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[Email] LIKE &amp;#x27;_%@_%._%&amp;#x27;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CK_User_PhoneNumber_ValidFormat&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;[PhoneNumber] NOT LIKE &amp;#x27;%[^0-9]%&amp;#x27; AND LEN(PhoneNumber) BETWEEN 7 AND 15&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="825" width="1450" height="139" as="geometry" />
        </mxCell>
        <mxCell id="enum-values" value="&lt;b&gt;Enums stored as nvarchar(200)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Reservations.Status&lt;/b&gt; (BookingStatus): Scheduled, Checked_In, Checked_Out, Cancelled, No_Show&lt;br&gt;&lt;br&gt;&lt;b&gt;Discounts.State&lt;/b&gt; (DiscountState): Pending, Active, Suspended, Expired&lt;br&gt;&lt;br&gt;&lt;b&gt;Hotels.Category&lt;/b&gt; (HotelCategory): Luxury, Budget, Boutique&lt;br&gt;&lt;br&gt;&lt;b&gt;Reservations.PaymentMethod&lt;/b&gt; (PaymentMethod): Visa, MasterCard, American_Express, Discover, Apple_Pay, Google_Pay, Samsung_Pay, PayPal, Stripe, Square&lt;br&gt;&lt;br&gt;&lt;b&gt;Rooms.Status&lt;/b&gt; (RoomStatus): Available, Unavailable, In_Use&lt;br&gt;&lt;br&gt;&lt;b&gt;UsersRoles.Role&lt;/b&gt; (SiteRole): Admin, User" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="70" y="982" width="1450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="constraint-notes" value="&lt;b&gt;Unique indexes:&lt;/b&gt; Users.Email, Users.UserName, RefreshTokens.Token.&lt;br&gt;Foreign-key columns have the indexes recorded in the snapshot; HotelAmenities.HotelId and UsersRoles.UserId are leading columns of their composite primary keys.&lt;br&gt;Enum members are application values; the database schema does not add CHECK constraints for enum membership." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="70" y="1297" width="1450" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
